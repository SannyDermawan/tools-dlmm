# Copy to .env and fill in. Never commit .env.
# Solana RPC (HTTP + WebSocket). A paid/dedicated RPC (Helius, Triton, ...) is strongly
# recommended: swap events require one getTransaction call per swap.
RPC_URL=https://api.mainnet-beta.solana.com
WS_URL=wss://api.mainnet-beta.solana.com

# Telegram (phase 12, optional; telegram.enabled in the config). Create a bot with @BotFather.
# TELEGRAM_CHAT_ID: where notifications go; TELEGRAM_ALLOWED_USER_IDS: comma-separated user ids
# whose commands are accepted (`npm run dlmm -- telegram whoami` prints the ids of recent senders).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
